# Build-context boundary for the Coliseum bot image.
# The accepted runtime data, secrets and local tooling live in this tree but
# must never be sent to the builder. Patterns are deliberately explicit.

# --- Secrets and credentials -------------------------------------------------
.env
.env.*
**/.env
**/.env.*
**/*.env
**/secrets
**/secrets/**
**/credentials
**/credentials/**
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.token
**/.netrc
**/.pypirc
**/id_rsa*
**/id_ed25519*
**/*credentials*.json
**/secrets*.json

# --- Runtime databases and SQLite sidecars -----------------------------------
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite3
**/*.sqlite*
**/*.wal
**/*.shm
**/*.journal
**/*.dump

# --- Mutable runtime storage, uploads, archives, backups ---------------------
storage
storage/**
**/storage
**/storage/**
backups
backups/**
**/backups
**/backups/**
.recovery_snapshot*
.recovery_snapshot*/**
**/.recovery_snapshot*
**/.recovery_snapshot*/**
.checkpoint*
.checkpoint*/**
**/.checkpoint*
**/.checkpoint*/**
checkpoints
checkpoints/**
**/checkpoints
**/checkpoints/**
logs
logs/**
**/logs
**/logs/**
**/*.log

# --- Archives and binary dumps ----------------------------------------------
*.zip
*.rar
*.7z
*.tar
*.tar.gz
*.tgz
*.gz
*.bz2
*.xz
**/*.zip
**/*.rar
**/*.7z
**/*.tar
**/*.tar.gz
**/*.tgz
**/*.gz
**/*.bz2
**/*.xz
**/*.bak
**/*.backup

# --- Python and local tooling -----------------------------------------------
.git
.gitignore
.gitattributes
.venv
venv
env
__pycache__
**/__pycache__
*.py[cod]
**/*.py[cod]
.pytest_cache
**/.pytest_cache
.mypy_cache
**/.mypy_cache
.ruff_cache
**/.ruff_cache
.coverage
.coverage*
htmlcov
.tox
.nox
*.egg-info
**/*.egg-info

# --- Tests, documentation, reports and deployment-only files ----------------
tests
tests/**
docs
docs/**
deploy
deploy/**
scripts
scripts/**
pytest.ini
requirements-dev-audit.txt
requirements-test-phase2.txt
compilation.txt
howtocompilate.txt
*.md
**/*.md
*.json
**/*.json
*:Zone.Identifier
**/*:Zone.Identifier
compose.yaml
compose.yml
compose.local.yaml
Dockerfile
.dockerignore
