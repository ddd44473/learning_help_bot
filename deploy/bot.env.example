# Coliseum bot — sample PRIVATE host env file.
# Copy this file to /opt/coliseum/secrets/bot.env on the VPS, fill in real
# values there, then: chown <deploy-user>:<deploy-user> /opt/coliseum/secrets/bot.env
#                    chmod 600 /opt/coliseum/secrets/bot.env
# Never commit the filled file, never bake it into an image, never put it in a
# backup, and never paste its contents into logs, chats or reports.
#
# Docker env-file values are visible to Docker administrators (docker inspect,
# /proc/<pid>/environ for privileged host users). This is a simple first-release
# mechanism, not an external cloud secrets manager.

# Required: Telegram bot token in the form <digits>:<secret>.
BOT_TOKEN=REPLACE_WITH_TELEGRAM_BOT_TOKEN

# Required: comma-separated positive Telegram user IDs of administrators.
ADMIN_IDS=REPLACE_WITH_ADMIN_ID_1,REPLACE_WITH_ADMIN_ID_2

# Required: negative forum supergroup ID, for example -100... (placeholder only).
MASTER_GROUP_ID=REPLACE_WITH_MINUS_100_FORUM_GROUP_ID

# Optional: username for the top-up contact, without the leading @.
TOPUP_ADMIN_USERNAME=REPLACE_WITH_TOPUP_USERNAME

# Optional: support manager username, without the leading @.
SUPPORT_USERNAME=REPLACE_WITH_SUPPORT_USERNAME

# STUDY_BOT_DB_PATH is intentionally NOT set here. compose.yaml injects the
# non-secret container path /data/database.db and overrides any stale value
# that might be copied from a developer .env file.
