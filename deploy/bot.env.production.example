# Coliseum of Knowledge — PRODUCTION env-file template.
#
# This file contains placeholders only. It is NOT a production configuration and
# must never be copied into the repository, the Docker image, a backup or a
# report after it is filled in.
#
# Production location on the VPS: /opt/coliseum/secrets/bot.env
# Owner: the user that runs `docker compose` (for example `deploy`)
# Mode:  600 (directory 700)
#
# Fill every REPLACE_WITH_... value on the VPS, then start the container.
# Never print this file, never pass it through chat, and never commit it.

# Required. Real bot token issued by @BotFather, format <digits>:<secret>.
BOT_TOKEN=REPLACE_WITH_PRODUCTION_BOT_TOKEN

# Required. Comma-separated NUMERIC Telegram user IDs of bot administrators.
# This is the ONLY setting that grants administrator permissions in code.
# The owner's Telegram user ID must be listed here.
ADMIN_IDS=REPLACE_WITH_OWNER_TELEGRAM_USER_ID

# Required. Negative numeric ID of the forum-enabled supergroup used by masters.
# It must start with -100 (for example -1001234567890).
MASTER_GROUP_ID=REPLACE_WITH_MINUS_100_FORUM_SUPERGROUP_ID

# Required for the "Пополнить баланс" contact button.
# Telegram username of the SEPARATE balance top-up contact, without the leading @.
# This username is used only as a contact link. It does NOT grant administrator
# permissions and is NOT the main administrator.
TOPUP_ADMIN_USERNAME=REPLACE_WITH_TOPUP_CONTACT_USERNAME

# Optional. Telegram username for the "Написать менеджеру" support buttons,
# without the leading @. This is a support contact, not an administrator.
SUPPORT_USERNAME=REPLACE_WITH_SUPPORT_MANAGER_USERNAME

# STUDY_BOT_DB_PATH is intentionally NOT set in this file.
# compose.yaml injects the non-secret container path /data/database.db and
# overrides any stale value copied from a developer .env file.
